{% extends 'base.html.twig' %}

{% block title %}Edit {{ category }} Tier List{% endblock %}

{# Collect unique filter values #}
{% set rarities = [] %}
{% set factions = [] %}
{% set types = [] %}
{% set affinities = [] %}
{% for hero in unrankedHeroes %}
    {% if hero.rarityEntity and hero.rarityEntity.name not in rarities %}
        {% set rarities = rarities|merge([hero.rarityEntity.name]) %}
    {% endif %}
    {% if hero.factionEntity and hero.factionEntity.name not in factions %}
        {% set factions = factions|merge([hero.factionEntity.name]) %}
    {% endif %}
    {% if hero.typeEntity and hero.typeEntity.name not in types %}
        {% set types = types|merge([hero.typeEntity.name]) %}
    {% endif %}
    {% if hero.affinityEntity and hero.affinityEntity.name not in affinities %}
        {% set affinities = affinities|merge([hero.affinityEntity.name]) %}
    {% endif %}
{% endfor %}

{% block stylesheets %}
{{ parent() }}
<style>
body {
    background: linear-gradient(135deg, rgba(8,11,30,0.97) 0%, rgba(18,22,50,0.97) 100%);
    min-height: 100vh;
    padding: 120px 16px 230px;
}

.page-wrap {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* ── TOP BAR ── */
.top-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    background: rgba(0,0,0,0.45);
    border: 1px solid rgba(0,255,136,0.2);
    border-radius: 10px;
    padding: 10px 16px;
}
.top-bar select {
    height: 34px;
    padding: 0 10px;
    background: rgba(10,14,39,0.9);
    border: 1px solid rgba(0,255,136,0.4);
    border-radius: 7px;
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
}
.top-bar select:focus { outline: none; border-color: #00ff88; }
.tb-label { color: rgba(0,255,136,0.6); font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
.tb-spacer { flex: 1; }
.btn-tb {
    height: 34px;
    padding: 0 16px;
    border-radius: 7px;
    border: none;
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: filter 0.2s, transform 0.15s;
    white-space: nowrap;
}
.btn-tb:hover { filter: brightness(1.15); transform: translateY(-1px); }
.btn-new  { background: rgba(0,255,136,0.12); color: #00ff88; border: 1px solid rgba(0,255,136,0.35); }
.btn-view { background: rgba(255,255,255,0.08); color: #ccc; border: 1px solid rgba(255,255,255,0.2); }
.btn-save { background: linear-gradient(135deg, #00ff88, #00ccff); color: #04081e; font-weight: 900; }
.btn-del  { background: linear-gradient(135deg, #ef4444, #b91c1c); color: #fff; }

/* ── TIER TABLE ── */
.tier-table {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.3);
}
.tier-row {
    display: flex;
    align-items: stretch;
    min-height: 90px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
.tier-row:last-child { border-bottom: none; }

.tier-label {
    width: 72px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.4rem;
    font-weight: 900;
    border-right: 1px solid rgba(255,255,255,0.08);
    user-select: none;
}

.tier-S { border-left: 4px solid #ff1744; }
.tier-S .tier-label { background: rgba(255,23,68,0.2); color: #ff1744; }
.tier-A { border-left: 4px solid #ff9100; }
.tier-A .tier-label { background: rgba(255,145,0,0.2); color: #ff9100; }
.tier-B { border-left: 4px solid #ffd600; }
.tier-B .tier-label { background: rgba(255,214,0,0.18); color: #ffd600; }
.tier-C { border-left: 4px solid #00e676; }
.tier-C .tier-label { background: rgba(0,230,118,0.18); color: #00e676; }
.tier-D { border-left: 4px solid #2979ff; }
.tier-D .tier-label { background: rgba(41,121,255,0.2); color: #2979ff; }
.tier-F { border-left: 4px solid #6b7280; }
.tier-F .tier-label { background: rgba(107,114,128,0.18); color: #9ca3af; }

.heroes-zone {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: flex-start;
    padding: 8px 12px;
    min-height: 90px;
    transition: background 0.15s;
}
.heroes-zone.over { background: rgba(0,255,136,0.07); }

/* ── HERO CARDS ── */
.hero-card {
    position: relative;
    width: 64px;
    height: 82px;
    border-radius: 7px;
    overflow: hidden;
    border: 2px solid rgba(255,255,255,0.2);
    cursor: grab;
    flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
}
.hero-card:active { cursor: grabbing; }
.hero-card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; display: block; }
.hero-card .hname {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.92));
    color: #fff;
    font-size: 0.5rem;
    font-weight: 700;
    text-align: center;
    padding: 3px 2px 4px;
    line-height: 1.2;
    pointer-events: none;
}
.hero-card:hover { transform: translateY(-4px) scale(1.06); box-shadow: 0 8px 20px rgba(0,0,0,0.5); z-index: 20; }

/* SortableJS */
.sortable-ghost  { opacity: 0.2 !important; border-style: dashed !important; }
.sortable-chosen { transform: scale(1.1) !important; box-shadow: 0 10px 28px rgba(0,255,136,0.6) !important; z-index: 9999 !important; }

/* Rarity borders */
.rarity-legendary, .rarity-légendaire { border-color: #ffd700 !important; }
.rarity-epic     { border-color: #a855f7 !important; }
.rarity-rare     { border-color: #3b82f6 !important; }
.rarity-uncommon { border-color: #10b981 !important; }
.rarity-common   { border-color: #6b7280 !important; }

/* ── FIXED HERO POOL ── */
.hero-pool {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 1000;
    background: rgba(4,6,20,0.97);
    border-top: 2px solid rgba(0,255,136,0.3);
    box-shadow: 0 -6px 30px rgba(0,0,0,0.7);
}
.pool-top {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-wrap: wrap;
}
.pool-title {
    color: #00ff88;
    font-size: 0.82rem;
    font-weight: 800;
    white-space: nowrap;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
}
.pool-badge {
    background: rgba(0,255,136,0.15);
    border: 1px solid rgba(0,255,136,0.3);
    color: #00ff88;
    padding: 0 7px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 18px;
}
.pool-filters { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; flex: 1; }
.pool-filters input,
.pool-filters select {
    height: 28px;
    padding: 0 8px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 6px;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
}
.pool-filters input { min-width: 120px; }
.pool-filters input::placeholder { color: rgba(255,255,255,0.28); font-weight: 400; }
.pool-filters input:focus,
.pool-filters select:focus { outline: none; border-color: rgba(0,255,136,0.5); }
.pool-filters select option { background: #06091c; }
.pool-filters select.on { border-color: #00ff88; color: #00ff88; }
.btn-reset {
    height: 28px; padding: 0 10px;
    background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
    border-radius: 6px; color: #f87171; font-size: 0.72rem; font-weight: 700;
    cursor: pointer; white-space: nowrap;
}
.btn-reset:hover { background: rgba(239,68,68,0.25); }
.btn-toggle-pool {
    height: 28px; padding: 0 10px;
    background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.16);
    border-radius: 6px; color: #aaa; font-size: 0.72rem; font-weight: 700;
    cursor: pointer; margin-left: auto;
}
.btn-toggle-pool:hover { background: rgba(255,255,255,0.14); }

.pool-cards {
    height: 150px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 8px 16px;
}
.pool-cards::-webkit-scrollbar { height: 5px; }
.pool-cards::-webkit-scrollbar-thumb { background: rgba(0,255,136,0.3); border-radius: 3px; }

#grid-pool {
    display: flex;
    flex-wrap: nowrap;
    gap: 6px;
    min-width: max-content;
    min-height: 100%;
    align-items: flex-start;
    padding: 2px;
}
#grid-pool .hero-card { width: 68px; height: 85px; }

.pool-empty-msg { color: rgba(255,255,255,0.25); font-size: 0.82rem; font-style: italic; align-self: center; white-space: nowrap; }

.hero-pool.collapsed .pool-cards { display: none; }
.hero-pool.collapsed { height: auto; }
.hero-pool.collapsed ~ * { padding-bottom: 60px; }

@media (max-width: 768px) {
    .tier-label { width: 52px; font-size: 1.8rem; }
    .hero-card { width: 54px; height: 68px; }
    #grid-pool .hero-card { width: 58px; height: 73px; }
    .pool-cards { height: 120px; }
}
</style>
{% endblock %}

{% block body %}
<div class="page-wrap">

    {# ── TOP BAR ── #}
    <div class="top-bar">
        <span class="tb-label">Category</span>
        <select onchange="location.href='{{ path('app_tier_list_edit', {category:'PLACEHOLDER'}) }}'.replace('PLACEHOLDER', this.value)">
            {% for cat in allCategories %}
                <option value="{{ cat }}" {{ cat == category ? 'selected' : '' }}>{{ cat }}</option>
            {% endfor %}
        </select>
        <button class="btn-tb btn-new" onclick="location.href='{{ path('app_tier_list_new') }}'">+ New</button>

        <div class="tb-spacer"></div>

        <a href="{{ path('app_tier_list_show', {category: category}) }}" class="btn-tb btn-view">View</a>
        <button id="save-btn" class="btn-tb btn-save">Save</button>
        <button class="btn-tb btn-del" onclick="if(confirm('Delete this tier list?')) document.getElementById('del-form').submit()">Delete</button>
        <form id="del-form" method="post" action="{{ path('app_tier_list_delete', {category: category}) }}" style="display:none">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category) }}">
        </form>
    </div>

    {# ── TIER TABLE ── #}
    <div class="tier-table">
        {% for tier in ['S','A','B','C','D','F'] %}
        <div class="tier-row tier-{{ tier }}">
            <div class="tier-label">{{ tier }}</div>
            <div class="heroes-zone" id="grid-{{ tier }}" data-tier="{{ tier }}">
                {% for entry in tierData[tier] %}
                    <div class="hero-card {% if entry.hero.rarityEntity %}rarity-{{ entry.hero.rarityEntity.name|lower }}{% endif %}"
                         data-hero-id="{{ entry.hero.id }}"
                         data-entry-id="{{ entry.id }}"
                         title="{{ entry.hero.name }}">
                        <img src="{{ entry.hero.imageUrl }}" alt="{{ entry.hero.name }}">
                        <div class="hname">{{ entry.hero.name }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endfor %}
    </div>

</div>{# end .page-wrap #}

{# ── FIXED HERO POOL ── #}
<div class="hero-pool" id="hero-pool">
    <div class="pool-top">
        <div class="pool-title" onclick="togglePool()">
            Bank <span class="pool-badge" id="pool-count">{{ unrankedHeroes|length }}</span>
        </div>

        <div class="pool-filters">
            <input type="text" id="f-name" placeholder="Search name…" oninput="applyFilters()">

            {% if rarities|length > 0 %}
            <select id="f-rarity" onchange="applyFilters()">
                <option value="">All Rarities</option>
                {% for r in rarities|sort %}<option value="{{ r|lower }}">{{ r }}</option>{% endfor %}
            </select>
            {% endif %}

            {% if factions|length > 0 %}
            <select id="f-faction" onchange="applyFilters()">
                <option value="">All Factions</option>
                {% for f in factions|sort %}<option value="{{ f|lower }}">{{ f }}</option>{% endfor %}
            </select>
            {% endif %}

            {% if types|length > 0 %}
            <select id="f-type" onchange="applyFilters()">
                <option value="">All Types</option>
                {% for t in types|sort %}<option value="{{ t|lower }}">{{ t }}</option>{% endfor %}
            </select>
            {% endif %}

            {% if affinities|length > 0 %}
            <select id="f-affinity" onchange="applyFilters()">
                <option value="">All Affinities</option>
                {% for a in affinities|sort %}<option value="{{ a|lower }}">{{ a }}</option>{% endfor %}
            </select>
            {% endif %}

            <button class="btn-reset" onclick="resetFilters()">Reset</button>
        </div>

        <button class="btn-toggle-pool" id="pool-toggle" onclick="togglePool()">Hide</button>
    </div>

    <div class="pool-cards">
        <div id="grid-pool" data-tier="pool">
            {% if unrankedHeroes|length == 0 %}
                <span class="pool-empty-msg">All heroes are ranked!</span>
            {% else %}
                {% for hero in unrankedHeroes %}
                    <div class="hero-card {% if hero.rarityEntity %}rarity-{{ hero.rarityEntity.name|lower }}{% endif %}"
                         data-hero-id="{{ hero.id }}"
                         data-entry-id=""
                         data-rarity="{{ hero.rarityEntity ? hero.rarityEntity.name|lower : '' }}"
                         data-faction="{{ hero.factionEntity ? hero.factionEntity.name|lower : '' }}"
                         data-type="{{ hero.typeEntity ? hero.typeEntity.name|lower : '' }}"
                         data-affinity="{{ hero.affinityEntity ? hero.affinityEntity.name|lower : '' }}"
                         title="{{ hero.name }}">
                        <img src="{{ hero.imageUrl }}" alt="{{ hero.name }}">
                        <div class="hname">{{ hero.name }}</div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
const category = '{{ category }}';

function togglePool() {
    const pool = document.getElementById('hero-pool');
    const btn  = document.getElementById('pool-toggle');
    pool.classList.toggle('collapsed');
    btn.textContent = pool.classList.contains('collapsed') ? 'Show' : 'Hide';
}

function updateCount() {
    const all     = document.querySelectorAll('#grid-pool .hero-card');
    const visible = [...all].filter(c => c.style.display !== 'none');
    document.getElementById('pool-count').textContent = visible.length;

    const grid  = document.getElementById('grid-pool');
    const empty = grid.querySelector('.pool-empty-msg');
    if (all.length === 0 && !empty) {
        const s = document.createElement('span');
        s.className = 'pool-empty-msg';
        s.textContent = 'All heroes are ranked!';
        grid.appendChild(s);
    } else if (all.length > 0 && empty) {
        empty.remove();
    }
}

function applyFilters() {
    const name    = (document.getElementById('f-name')?.value     || '').toLowerCase().trim();
    const rarity  = (document.getElementById('f-rarity')?.value   || '').toLowerCase();
    const faction = (document.getElementById('f-faction')?.value  || '').toLowerCase();
    const type    = (document.getElementById('f-type')?.value     || '').toLowerCase();
    const aff     = (document.getElementById('f-affinity')?.value || '').toLowerCase();

    ['f-rarity','f-faction','f-type','f-affinity'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('on', el.value !== '');
    });

    document.querySelectorAll('#grid-pool .hero-card').forEach(card => {
        const ok = (!name    || card.title.toLowerCase().includes(name))
                && (!rarity  || card.dataset.rarity   === rarity)
                && (!faction || card.dataset.faction  === faction)
                && (!type    || card.dataset.type     === type)
                && (!aff     || card.dataset.affinity === aff);
        card.style.display = ok ? '' : 'none';
    });
    updateCount();
}

function resetFilters() {
    ['f-name','f-rarity','f-faction','f-type','f-affinity'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.value = ''; el.classList.remove('on'); }
    });
    document.querySelectorAll('#grid-pool .hero-card').forEach(c => c.style.display = '');
    updateCount();
}

/* SortableJS */
['S','A','B','C','D','F'].forEach(tier => {
    new Sortable(document.getElementById('grid-' + tier), {
        group: 'heroes', animation: 130,
        ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
        onAdd() { updateCount(); }, onRemove() { updateCount(); },
    });
});
new Sortable(document.getElementById('grid-pool'), {
    group: 'heroes', animation: 130,
    ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
    onAdd(e)   { e.item.style.display = ''; updateCount(); },
    onRemove() { updateCount(); },
});

/* Save */
document.getElementById('save-btn').addEventListener('click', async function () {
    this.disabled = true; this.textContent = 'Saving…';

    const updates = [], toDelete = [];

    ['S','A','B','C','D','F'].forEach(tier => {
        document.querySelectorAll('#grid-' + tier + ' .hero-card').forEach((card, i) => {
            updates.push({ id: card.dataset.entryId || null, heroId: card.dataset.heroId, tier, order: i, category });
        });
    });
    document.querySelectorAll('#grid-pool .hero-card').forEach(card => {
        if (card.dataset.entryId) toDelete.push(card.dataset.entryId);
    });

    try {
        for (const id of toDelete)
            await fetch('/tier-list/api/remove-hero/' + id, { method: 'DELETE' });

        for (const u of updates) {
            if (!u.id) {
                const r = await fetch('{{ path('app_tier_list_api_add') }}', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ heroId: u.heroId, tier: u.tier, category })
                });
                const d = await r.json();
                if (d.entryId) u.id = d.entryId;
            }
        }

        const existing = updates.filter(u => u.id);
        if (existing.length)
            await fetch('{{ path('app_tier_list_api_update_order') }}', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(existing)
            });

        alert('Saved!');
        location.reload();
    } catch (e) {
        console.error(e); alert('Save failed.');
        this.disabled = false; this.textContent = 'Save';
    }
});
</script>
{% endblock %}
