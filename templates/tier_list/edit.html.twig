{% extends 'base.html.twig' %}
{% block title %}Éditer — {{ mode.name }}{% endblock %}

{# Collect filter values from unranked heroes #}
{% set rarities = [] %}
{% set factions = [] %}
{% set types = [] %}
{% set affinities = [] %}
{% for hero in unrankedHeroes %}
    {% if hero.rarityEntity and hero.rarityEntity.name not in rarities %}
        {% set rarities = rarities|merge([hero.rarityEntity.name]) %}
    {% endif %}
    {% if hero.factionEntity and hero.factionEntity.name not in factions %}
        {% set factions = factions|merge([hero.factionEntity.name]) %}
    {% endif %}
    {% if hero.typeEntity and hero.typeEntity.name not in types %}
        {% set types = types|merge([hero.typeEntity.name]) %}
    {% endif %}
    {% if hero.affinityEntity and hero.affinityEntity.name not in affinities %}
        {% set affinities = affinities|merge([hero.affinityEntity.name]) %}
    {% endif %}
{% endfor %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Layout global ── */
.tl-wrapper { display: flex; min-height: calc(100vh - 110px); }

/* ── Sidebar ── */
.tl-sidebar {
    width: 220px;
    flex-shrink: 0;
    background: rgba(0,0,0,0.55);
    border-right: 1px solid rgba(255,255,255,0.07);
    padding: 20px 0;
    position: sticky;
    top: 110px;
    height: calc(100vh - 110px);
    overflow-y: auto;
}
.tl-sidebar::-webkit-scrollbar { width: 4px; }
.tl-sidebar::-webkit-scrollbar-thumb { background: rgba(0,255,136,0.3); border-radius: 2px; }

.tl-group-label {
    font-size: 0.62rem;
    font-weight: 900;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 14px 16px 5px;
}
.tl-mode-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    border-left: 3px solid transparent;
}
.tl-mode-link:hover { background: rgba(255,255,255,0.05); color: #fff; }
.tl-mode-link.active {
    color: #00ff88;
    border-left-color: #00ff88;
    background: rgba(0,255,136,0.07);
    font-weight: 700;
}
.tl-mode-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
}
.tl-mode-link.active .tl-mode-dot { background: #00ff88; }

/* ── Contenu ── */
.tl-main { flex: 1; padding: 24px 28px 220px; min-width: 0; }

/* ── Header ── */
.edit-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    flex-wrap: wrap;
}
.edit-mode-title { font-size: 1.4rem; font-weight: 900; color: #00ff88; flex: 1; }
.btn-eh {
    height: 34px; padding: 0 16px;
    border-radius: 7px; border: none;
    font-weight: 700; font-size: 0.82rem;
    cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    text-decoration: none; transition: filter 0.18s, transform 0.14s;
    white-space: nowrap;
}
.btn-eh:hover { filter: brightness(1.15); transform: translateY(-1px); }
.btn-view { background: rgba(255,255,255,0.08); color: #ccc; border: 1px solid rgba(255,255,255,0.2); }
.btn-save { background: linear-gradient(135deg, #00ff88, #00ccff); color: #04081e; font-weight: 900; }

/* ── Tier table ── */
.tier-table { border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.3); }
.tier-row { display: flex; align-items: stretch; min-height: 90px; border-bottom: 1px solid rgba(255,255,255,0.06); }
.tier-row:last-child { border-bottom: none; }
.tier-label {
    width: 80px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 2.2rem; font-weight: 900;
    border-right: 1px solid rgba(255,255,255,0.08);
    user-select: none; letter-spacing: -1px;
}
.tier-SSS .tier-label, .tier-SS .tier-label { font-size: 1.5rem; letter-spacing: -2px; }
.tier-SSS { border-left: 4px solid #fff5c0; } .tier-SSS .tier-label { background: rgba(255,245,192,0.12); color: #fff5c0; text-shadow: 0 0 12px rgba(255,245,192,0.6); }
.tier-SS  { border-left: 4px solid #f6c90e; } .tier-SS  .tier-label { background: rgba(246,201,14,0.15);  color: #f6c90e; text-shadow: 0 0 10px rgba(246,201,14,0.5); }
.tier-S   { border-left: 4px solid #fb8c00; } .tier-S   .tier-label { background: rgba(251,140,0,0.15);   color: #fb8c00; }
.tier-A   { border-left: 4px solid #ea580c; } .tier-A   .tier-label { background: rgba(234,88,12,0.18);   color: #ea580c; }
.tier-B   { border-left: 4px solid #ca8a04; } .tier-B   .tier-label { background: rgba(202,138,4,0.15);   color: #ca8a04; }
.tier-C   { border-left: 4px solid #16a34a; } .tier-C   .tier-label { background: rgba(22,163,74,0.15);   color: #16a34a; }
.tier-D   { border-left: 4px solid #2563eb; } .tier-D   .tier-label { background: rgba(37,99,235,0.18);   color: #2563eb; }

.heroes-zone {
    flex: 1; display: flex; flex-wrap: wrap;
    gap: 6px; align-content: flex-start;
    padding: 8px 12px; min-height: 90px;
    transition: background 0.15s;
}
.heroes-zone.over { background: rgba(0,255,136,0.07); }

/* ── Hero cards ── */
.hero-card {
    position: relative; width: 64px; height: 82px;
    border-radius: 7px; overflow: hidden;
    border: 2px solid rgba(255,255,255,0.2);
    cursor: pointer; flex-shrink: 0;
    transition: transform 0.15s, box-shadow 0.15s;
    user-select: none;
}
.hero-card img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; display: block; }
.hero-card .hname {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.92));
    color: #fff; font-size: 0.5rem; font-weight: 700;
    text-align: center; padding: 3px 2px 4px; line-height: 1.2; pointer-events: none;
}
.hero-card:hover { transform: translateY(-4px) scale(1.06); box-shadow: 0 8px 20px rgba(0,0,0,0.5); z-index: 20; }

/* SortableJS */
.sortable-ghost  { opacity: 0.2 !important; border-style: dashed !important; }
.sortable-chosen { transform: scale(1.1) !important; box-shadow: 0 10px 28px rgba(0,255,136,0.6) !important; z-index: 9999 !important; }

/* Rarity borders */
.rarity-legendary, .rarity-légendaire { border-color: #ffd700 !important; }
.rarity-epic     { border-color: #a855f7 !important; }
.rarity-rare     { border-color: #3b82f6 !important; }
.rarity-uncommon { border-color: #10b981 !important; }
.rarity-common   { border-color: #6b7280 !important; }

/* ── Hero modal ── */
#hero-modal .modal-dialog { max-width: 860px; }
#hero-modal .modal-content {
    background: rgba(8,11,30,0.99);
    border: 1px solid rgba(0,255,136,0.25);
    border-radius: 14px; overflow: hidden; color: #fff;
    max-height: 88vh; display: flex; flex-direction: column;
}
#hero-modal .modal-header { padding: 10px 16px; background: rgba(0,0,0,0.4); border-bottom: 1px solid rgba(255,255,255,0.08); flex-shrink: 0; }
#hero-modal .modal-title { color: #00ff88; font-weight: 800; font-size: 0.9rem; }
#hero-modal .btn-close { filter: invert(1); opacity: 0.6; }
#hero-modal .modal-body { padding: 0; overflow-y: auto; flex: 1; }
#hero-modal .modal-body::-webkit-scrollbar { width: 6px; }
#hero-modal .modal-body::-webkit-scrollbar-thumb { background: rgba(0,255,136,0.3); border-radius: 3px; }
.modal-loading { display: flex; align-items: center; justify-content: center; height: 200px; color: rgba(255,255,255,0.4); font-size: 0.9rem; gap: 10px; }

/* ── Fixed hero pool ── */
.hero-pool {
    position: fixed; bottom: 0; left: 220px; right: 0;
    z-index: 1000;
    background: rgba(4,6,20,0.97);
    border-top: 2px solid rgba(0,255,136,0.3);
    box-shadow: 0 -6px 30px rgba(0,0,0,0.7);
}
.pool-top {
    display: flex; align-items: center; gap: 8px;
    padding: 7px 16px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    flex-wrap: wrap;
}
.pool-title { color: #00ff88; font-size: 0.82rem; font-weight: 800; white-space: nowrap; cursor: pointer; display: flex; align-items: center; gap: 6px; }
.pool-badge { background: rgba(0,255,136,0.15); border: 1px solid rgba(0,255,136,0.3); color: #00ff88; padding: 0 7px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; line-height: 18px; }
.pool-filters { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; flex: 1; }
.pool-filters input, .pool-filters select {
    height: 28px; padding: 0 8px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.16);
    border-radius: 6px; color: #fff; font-size: 0.75rem; font-weight: 600; cursor: pointer;
}
.pool-filters input { min-width: 120px; }
.pool-filters input::placeholder { color: rgba(255,255,255,0.28); font-weight: 400; }
.pool-filters input:focus, .pool-filters select:focus { outline: none; border-color: rgba(0,255,136,0.5); }
.pool-filters select option { background: #06091c; }
.pool-filters select.on { border-color: #00ff88; color: #00ff88; }
.btn-reset { height: 28px; padding: 0 10px; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); border-radius: 6px; color: #f87171; font-size: 0.72rem; font-weight: 700; cursor: pointer; white-space: nowrap; }
.btn-reset:hover { background: rgba(239,68,68,0.25); }
.btn-toggle-pool { height: 28px; padding: 0 10px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.16); border-radius: 6px; color: #aaa; font-size: 0.72rem; font-weight: 700; cursor: pointer; margin-left: auto; }
.btn-toggle-pool:hover { background: rgba(255,255,255,0.14); }
.pool-cards { height: 150px; overflow-x: auto; overflow-y: hidden; padding: 8px 16px; }
.pool-cards::-webkit-scrollbar { height: 5px; }
.pool-cards::-webkit-scrollbar-thumb { background: rgba(0,255,136,0.3); border-radius: 3px; }
#grid-pool { display: flex; flex-wrap: nowrap; gap: 6px; min-width: max-content; min-height: 100%; align-items: flex-start; padding: 2px; }
#grid-pool .hero-card { width: 68px; height: 85px; }
.pool-empty-msg { color: rgba(255,255,255,0.25); font-size: 0.82rem; font-style: italic; align-self: center; white-space: nowrap; }
.hero-pool.collapsed .pool-cards { display: none; }
.hero-pool.collapsed { height: auto; }
</style>
{% endblock %}

{% block body %}
<div class="tl-wrapper">

    {# ── SIDEBAR ── #}
    <nav class="tl-sidebar">
        {% for groupName, modes in groupedModes %}
            <div class="tl-group-label">{{ groupName }}</div>
            {% for m in modes %}
                <a href="{{ path('app_tier_list_edit', {slug: m.slug}) }}"
                   class="tl-mode-link {{ m.slug == mode.slug ? 'active' : '' }}">
                    <span class="tl-mode-dot"></span>
                    {{ m.name }}
                </a>
            {% endfor %}
        {% endfor %}
    </nav>

    {# ── CONTENU ── #}
    <div class="tl-main">

        <div class="edit-header">
            <div class="edit-mode-title">{{ mode.name }}</div>
            <a href="{{ path('app_tier_list_show', {slug: mode.slug}) }}" class="btn-eh btn-view">
                <i class="fas fa-eye"></i> Voir
            </a>
            <button id="save-btn" class="btn-eh btn-save">
                <i class="fas fa-save"></i> Sauvegarder
            </button>
        </div>

        {# ── TIER TABLE ── #}
        <div class="tier-table">
            {% for tier in ['SSS','SS','S','A','B','C','D'] %}
            <div class="tier-row tier-{{ tier }}">
                <div class="tier-label">{{ tier }}</div>
                <div class="heroes-zone" id="grid-{{ tier }}" data-tier="{{ tier }}">
                    {% for entry in tierData[tier] %}
                        <div class="hero-card {% if entry.hero.rarityEntity %}rarity-{{ entry.hero.rarityEntity.name|lower }}{% endif %}"
                             data-hero-id="{{ entry.hero.id }}"
                             data-entry-id="{{ entry.id }}"
                             data-slug="{{ entry.hero.slug }}"
                             data-rarity="{{ entry.hero.rarityEntity ? entry.hero.rarityEntity.name : '' }}"
                             data-faction="{{ entry.hero.factionEntity ? entry.hero.factionEntity.name : '' }}"
                             data-type="{{ entry.hero.typeEntity ? entry.hero.typeEntity.name : '' }}"
                             data-affinity="{{ entry.hero.affinityEntity ? entry.hero.affinityEntity.name : '' }}"
                             title="{{ entry.hero.name }}">
                            <img src="{{ entry.hero.imageUrl }}" alt="{{ entry.hero.name }}">
                            <div class="hname">{{ entry.hero.name }}</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}
        </div>

    </div>{# /tl-main #}
</div>{# /tl-wrapper #}

{# ── Hero modal ── #}
<div class="modal fade" id="hero-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-title" id="modal-title">Hero</span>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modal-body">
                <div class="modal-loading"><i class="fas fa-spinner fa-spin"></i> Loading…</div>
            </div>
        </div>
    </div>
</div>

{# ── Fixed hero pool (décalé de la largeur de la sidebar) ── #}
<div class="hero-pool" id="hero-pool">
    <div class="pool-top">
        <div class="pool-title" onclick="togglePool()">
            Bank <span class="pool-badge" id="pool-count">{{ unrankedHeroes|length }}</span>
        </div>
        <div class="pool-filters">
            <input type="text" id="f-name" placeholder="Rechercher…" oninput="applyFilters()">
            {% if rarities|length > 0 %}
            <select id="f-rarity" onchange="applyFilters()">
                <option value="">Toutes raretés</option>
                {% for r in rarities|sort %}<option value="{{ r|lower }}">{{ r }}</option>{% endfor %}
            </select>
            {% endif %}
            {% if factions|length > 0 %}
            <select id="f-faction" onchange="applyFilters()">
                <option value="">Toutes factions</option>
                {% for f in factions|sort %}<option value="{{ f|lower }}">{{ f }}</option>{% endfor %}
            </select>
            {% endif %}
            {% if types|length > 0 %}
            <select id="f-type" onchange="applyFilters()">
                <option value="">Tous types</option>
                {% for t in types|sort %}<option value="{{ t|lower }}">{{ t }}</option>{% endfor %}
            </select>
            {% endif %}
            {% if affinities|length > 0 %}
            <select id="f-affinity" onchange="applyFilters()">
                <option value="">Toutes affinités</option>
                {% for a in affinities|sort %}<option value="{{ a|lower }}">{{ a }}</option>{% endfor %}
            </select>
            {% endif %}
            <button class="btn-reset" onclick="resetFilters()">Reset</button>
        </div>
        <button class="btn-toggle-pool" id="pool-toggle" onclick="togglePool()">Masquer</button>
    </div>
    <div class="pool-cards">
        <div id="grid-pool" data-tier="pool">
            {% if unrankedHeroes|length == 0 %}
                <span class="pool-empty-msg">Tous les héros sont classés !</span>
            {% else %}
                {% for hero in unrankedHeroes %}
                    <div class="hero-card {% if hero.rarityEntity %}rarity-{{ hero.rarityEntity.name|lower }}{% endif %}"
                         data-hero-id="{{ hero.id }}"
                         data-entry-id=""
                         data-slug="{{ hero.slug }}"
                         data-rarity="{{ hero.rarityEntity ? hero.rarityEntity.name : '' }}"
                         data-faction="{{ hero.factionEntity ? hero.factionEntity.name : '' }}"
                         data-type="{{ hero.typeEntity ? hero.typeEntity.name : '' }}"
                         data-affinity="{{ hero.affinityEntity ? hero.affinityEntity.name : '' }}"
                         title="{{ hero.name }}">
                        <img src="{{ hero.imageUrl }}" alt="{{ hero.name }}">
                        <div class="hname">{{ hero.name }}</div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
const modeSlug = '{{ mode.slug }}';

/* ── Drag detection ── */
let dragHappened = false;

function makeSortable(el, extra = {}) {
    return new Sortable(el, {
        group: 'heroes', animation: 130,
        ghostClass: 'sortable-ghost', chosenClass: 'sortable-chosen',
        onStart() { dragHappened = true; },
        onEnd()   { setTimeout(() => { dragHappened = false; }, 80); updateCount(); },
        onAdd(e)  { e.item.style.display = ''; updateCount(); },
        onRemove(){ updateCount(); },
        ...extra
    });
}

['SSS','SS','S','A','B','C','D'].forEach(t => makeSortable(document.getElementById('grid-' + t)));
makeSortable(document.getElementById('grid-pool'));

/* ── Click → modal ── */
const heroCache = {};

document.addEventListener('click', async e => {
    const card = e.target.closest('.hero-card');
    if (!card || dragHappened) return;

    const slug = card.dataset.slug || '';
    const name = card.title;

    document.getElementById('modal-title').textContent = name;
    document.getElementById('modal-body').innerHTML =
        '<div class="modal-loading"><i class="fas fa-spinner fa-spin"></i> Loading…</div>';

    bootstrap.Modal.getOrCreateInstance(document.getElementById('hero-modal')).show();

    if (!slug) {
        document.getElementById('modal-body').innerHTML = '<div class="modal-loading">No hero page available.</div>';
        return;
    }
    if (heroCache[slug]) { document.getElementById('modal-body').innerHTML = heroCache[slug]; return; }

    try {
        const res  = await fetch('/heroes/' + slug + '/modal');
        heroCache[slug] = await res.text();
        document.getElementById('modal-body').innerHTML = heroCache[slug];
    } catch {
        document.getElementById('modal-body').innerHTML = '<div class="modal-loading">Failed to load hero data.</div>';
    }
}, true);

/* ── Pool ── */
function togglePool() {
    const pool = document.getElementById('hero-pool');
    const btn  = document.getElementById('pool-toggle');
    pool.classList.toggle('collapsed');
    btn.textContent = pool.classList.contains('collapsed') ? 'Afficher' : 'Masquer';
}

function updateCount() {
    const all   = document.querySelectorAll('#grid-pool .hero-card');
    const vis   = [...all].filter(c => c.style.display !== 'none');
    document.getElementById('pool-count').textContent = vis.length;
    const empty = document.querySelector('#grid-pool .pool-empty-msg');
    if (all.length === 0 && !empty) {
        const s = document.createElement('span');
        s.className = 'pool-empty-msg'; s.textContent = 'Tous les héros sont classés !';
        document.getElementById('grid-pool').appendChild(s);
    } else if (all.length > 0 && empty) { empty.remove(); }
}

/* ── Filters ── */
function applyFilters() {
    const name    = (document.getElementById('f-name')?.value     || '').toLowerCase().trim();
    const rarity  = (document.getElementById('f-rarity')?.value   || '').toLowerCase();
    const faction = (document.getElementById('f-faction')?.value  || '').toLowerCase();
    const type    = (document.getElementById('f-type')?.value     || '').toLowerCase();
    const aff     = (document.getElementById('f-affinity')?.value || '').toLowerCase();
    ['f-rarity','f-faction','f-type','f-affinity'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.toggle('on', el.value !== '');
    });
    document.querySelectorAll('#grid-pool .hero-card').forEach(card => {
        const ok = (!name    || card.title.toLowerCase().includes(name))
                && (!rarity  || card.dataset.rarity.toLowerCase()   === rarity)
                && (!faction || card.dataset.faction.toLowerCase()  === faction)
                && (!type    || card.dataset.type.toLowerCase()     === type)
                && (!aff     || card.dataset.affinity.toLowerCase() === aff);
        card.style.display = ok ? '' : 'none';
    });
    updateCount();
}

function resetFilters() {
    ['f-name','f-rarity','f-faction','f-type','f-affinity'].forEach(id => {
        const el = document.getElementById(id);
        if (el) { el.value = ''; el.classList.remove('on'); }
    });
    document.querySelectorAll('#grid-pool .hero-card').forEach(c => c.style.display = '');
    updateCount();
}

/* ── Save ── */
document.getElementById('save-btn').addEventListener('click', async function () {
    this.disabled = true; this.textContent = 'Sauvegarde…';
    const updates = [], toDelete = [];

    ['SSS','SS','S','A','B','C','D'].forEach(tier => {
        document.querySelectorAll('#grid-' + tier + ' .hero-card').forEach((card, i) => {
            updates.push({ id: card.dataset.entryId || null, heroId: card.dataset.heroId, tier, order: i, category: modeSlug });
        });
    });
    document.querySelectorAll('#grid-pool .hero-card').forEach(card => {
        if (card.dataset.entryId) toDelete.push(card.dataset.entryId);
    });

    try {
        for (const id of toDelete)
            await fetch('/tier-list/api/remove-hero/' + id, { method: 'DELETE' });

        for (const u of updates) {
            if (!u.id) {
                const r = await fetch('{{ path('app_tier_list_api_add') }}', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ heroId: u.heroId, tier: u.tier, category: modeSlug })
                });
                const d = await r.json();
                if (d.entryId) u.id = d.entryId;
            }
        }

        const existing = updates.filter(u => u.id);
        if (existing.length) {
            await fetch('{{ path('app_tier_list_api_update_order') }}', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(existing)
            });
        }

        this.textContent = 'Sauvegardé !';
        setTimeout(() => location.reload(), 800);
    } catch (e) {
        console.error(e); alert('Erreur lors de la sauvegarde.');
        this.disabled = false; this.textContent = 'Sauvegarder';
    }
});
</script>
{% endblock %}
