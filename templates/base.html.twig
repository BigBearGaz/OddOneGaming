<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5HWPMHXL');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NBZBHH2Q8B"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NBZBHH2Q8B');
    </script>

    <title>{% block title %}OddOne Gaming | Godforge Database & Tier Lists{% endblock %}</title>
    
    <link rel="icon" type="image/png" href="{{ asset('images/OddOneGaming_Logo.png') }}">

    <meta name="description" content="The ultimate English reference for Godforge. Get the latest hero tier lists, weapon builds, dungeon guides, and game mechanics.">
    <meta name="keywords" content="Godforge, Godforge Guide, Godforge Tier List, RPG, Hero Builds, Dungeon Strategy, OddOne Gaming">
    <meta name="author" content="OddOne Gaming">

    <meta property="og:title" content="OddOne Gaming - Godforge Reference Hub">
    <meta property="og:description" content="Master Godforge with our comprehensive database: Heroes, Weapons, and Mechanics.">
    <meta property="og:image" content="{{ asset('images/OddOneGaming_Logo.png') }}">
    <meta property="og:type" content="website">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            /* IMAGE DE FOND (A remplacer par ton URL ou chemin local) */
            background-image: url('/images/OddOne_Gaming_CastleTheme_jpg.jpg'); 
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-repeat: no-repeat;
            min-height: 100vh;
            color: #ffffff;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: -1;
        }

        nav.navbar {
            background: rgba(0, 0, 0, 0.85) !important;
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(0, 255, 0, 0.4);
            padding: 15px 0;
        }

        .navbar-brand img { 
            height: 70px; 
            transition: transform 0.3s ease;
        }
        
        .navbar-brand img:hover { transform: scale(1.1); }

        .navbar-nav .nav-link {
            color: #00ff00 !important;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 1.2px;
            margin: 0 5px;
        }

        .navbar-nav .nav-link:hover {
            color: #ffffff !important;
            text-shadow: 0 0 15px #00ff00;
        }

        .dropdown-menu {
            background: rgba(0, 0, 0, 0.95) !important;
            backdrop-filter: blur(20px);
            border: 1px solid rgba(0, 255, 0, 0.3);
            border-radius: 8px;
        }

        .dropdown-item {
            color: #00ff00 !important;
            font-weight: 600;
            font-size: 0.9rem;
            padding: 10px 25px;
            transition: all 0.2s;
        }

        .dropdown-item:hover {
            background: rgba(0, 255, 0, 0.15) !important;
            color: #ffffff !important;
            padding-left: 30px;
        }

        .dungeon-mini-icon {
            width: 26px;
            height: 26px;
            object-fit: cover;
            border-radius: 50%;
            border: 1px solid #00ff00;
        }

        .nav-admin-btn {
            border: 1px solid #0dcaf0;
            background: rgba(13, 202, 240, 0.1);
            color: #0dcaf0 !important;
        }

        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #0a0a0a; }
        ::-webkit-scrollbar-thumb { background: #00ff00; border-radius: 5px; }

        {% block stylesheets %}{% endblock %}
    </style>
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5HWPMHXL"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <img src="{{ asset('images/OddOneGaming_Logo.png') }}" alt="OddOne Gaming Logo">
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_heroes_index') }}">Heroes</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_takeovers_index') }}">Takeover</a></li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="mechDrop" data-bs-toggle="dropdown">Mechanics</a>
                        <ul class="dropdown-menu shadow">
                            <li><a class="dropdown-item" href="{{ path('app_buffs_index') }}"><i class="fas fa-arrow-up me-2 text-success"></i> Buffs</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_debuffs_index') }}"><i class="fas fa-arrow-down me-2 text-danger"></i> Debuffs</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_disable_index') }}"><i class="fas fa-hand-paper me-2 text-warning"></i> Disables</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="dungDrop" data-bs-toggle="dropdown">Dungeons</a>
                        <ul class="dropdown-menu shadow">
                            <li><a class="dropdown-item py-2" href="{{ path('app_dungeons_index') }}"><i class="fas fa-skull me-2 text-success"></i> <strong>All Bosses</strong></a></li>
                            {% if global_dungeons is defined and global_dungeons|length > 0 %}
                                <li><hr class="dropdown-divider"></li>
                                {% for dungeon in global_dungeons|slice(0, 6) %}
                                    <li>
                                        <a class="dropdown-item d-flex align-items-center" href="{{ path('app_dungeons_show', {'id': dungeon.id}) }}">
                                            <img src="{{ dungeon.imageUrl ? dungeon.imageUrl : 'https://ui-avatars.com/api/?name=' ~ dungeon.name|url_encode ~ '&background=00ff00&color=000' }}" class="dungeon-mini-icon me-2">
                                            <span>{{ dungeon.name }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            {% endif %}
                        </ul>
                    </li>

                    <li class="nav-item"><a class="nav-link" href="{{ path('app_weapons_index') }}">Weapons</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_sets_index') }}">Sets</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_tier_list_index') }}">Tier Lists</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_contact') }}">Contact</a></li>

                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item dropdown ms-lg-3">
                            <a class="nav-link dropdown-toggle nav-admin-btn" href="#" id="adminDrop" data-bs-toggle="dropdown">
                                <i class="fas fa-tools me-1"></i> Admin
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li><a class="dropdown-item fw-bold" href="{{ path('app_admin_dashboard') }}"><i class="fas fa-tachometer-alt me-2 text-warning"></i> Dashboard</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">System Management</h6></li>
                                <li><a class="dropdown-item" href="{{ path('app_buffs_index') }}">Edit Buffs</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_debuffs_index') }}">Edit Debuffs</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_disable_index') }}">Edit Disables</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_instants_index') }}"><i class="fas fa-bolt me-2 text-warning"></i> Edit Instants</a></li>                                
                                <li><hr class="dropdown-divider"></li>
                                <li><h6 class="dropdown-header">Content</h6></li>
                                <li><a class="dropdown-item text-info" href="{{ path('app_dungeons_new') }}"><i class="fas fa-plus-circle me-1"></i> Add Boss</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_sets_index') }}">Sets Config</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger fw-bold" href="{{ path('app_logout') }}"><i class="fas fa-power-off me-2"></i> Logout</a></li>
                            </ul>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main class="container-fluid p-0" style="margin-top: 110px;">
        {% block body %}{% endblock %}
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>