{% extends 'base.html.twig' %}

{% block title %}Godforge Buffs, Debuffs & Disables{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        body {
            background: linear-gradient(135deg, #1a1f3a 0%, #0a0e27 100%);
            min-height: 100vh;
            padding: 100px 20px 50px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        .effects-container { max-width: 1600px; margin: 0 auto; }

        .back-btn {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 12px 30px; background: rgba(255,255,255,0.05);
            color: #00ff88; text-decoration: none; border-radius: 25px;
            font-weight: 600; border: 1px solid rgba(0,255,136,0.3);
            transition: all 0.3s ease; margin-bottom: 30px;
        }
        .back-btn:hover { background: rgba(0,255,136,0.1); border-color: #00ff88; transform: translateX(-5px); color: #00ff88; }

        .page-header { text-align: center; margin-bottom: 40px; }
        .page-title { font-size: 3rem; font-weight: 900; color: #fff; margin-bottom: 10px; }
        .page-subtitle { color: rgba(255,255,255,0.6); font-size: 1.1rem; }

        /* ── TABS ── */
        .tabs-nav {
            display: flex; gap: 0; margin-bottom: 40px;
            border-radius: 14px; overflow: hidden;
            border: 1px solid rgba(255,255,255,0.1);
            background: rgba(255,255,255,0.03);
        }
        .tab-btn {
            flex: 1; padding: 16px 20px;
            background: transparent; border: none; cursor: pointer;
            font-size: 1rem; font-weight: 700; letter-spacing: 0.5px;
            color: rgba(255,255,255,0.45); transition: all 0.25s ease;
            display: flex; align-items: center; justify-content: center; gap: 10px;
            border-right: 1px solid rgba(255,255,255,0.08);
            position: relative;
        }
        .tab-btn:last-child { border-right: none; }
        .tab-btn:hover { color: rgba(255,255,255,0.8); background: rgba(255,255,255,0.05); }

        .tab-btn[data-tab="buff"].active    { color: #3b82f6; background: rgba(59,130,246,0.12); }
        .tab-btn[data-tab="debuff"].active  { color: #ef4444; background: rgba(239,68,68,0.12); }
        .tab-btn[data-tab="disable"].active { color: #a855f7; background: rgba(168,85,247,0.12); }
        .tab-btn.active::after {
            content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
            background: currentColor; border-radius: 3px 3px 0 0;
        }

        .tab-count {
            font-size: 0.75rem; font-weight: 600; padding: 2px 8px;
            border-radius: 20px; background: rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.5);
        }
        .tab-btn.active .tab-count {
            background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.85);
        }

        /* ── PANELS ── */
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        .effects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
        }

        .effect-card {
            background: rgba(255,255,255,0.03);
            border-radius: 15px; padding: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease; position: relative; overflow: hidden;
            display: flex; flex-direction: column; gap: 12px;
        }
        .effect-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.4); }
        .effect-card.buff    { --ac: #3b82f6; border-color: rgba(59,130,246,0.2); }
        .effect-card.buff:hover { border-color: rgba(59,130,246,0.6); box-shadow: 0 12px 32px rgba(59,130,246,0.15); }
        .effect-card.debuff  { --ac: #ef4444; border-color: rgba(239,68,68,0.2); }
        .effect-card.debuff:hover { border-color: rgba(239,68,68,0.6); box-shadow: 0 12px 32px rgba(239,68,68,0.15); }
        .effect-card.disable { --ac: #a855f7; border-color: rgba(168,85,247,0.2); }
        .effect-card.disable:hover { border-color: rgba(168,85,247,0.6); box-shadow: 0 12px 32px rgba(168,85,247,0.15); }
        .effect-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, transparent, var(--ac), transparent);
        }

        .card-header { display: flex; align-items: center; gap: 14px; }

        .effect-icon-wrap {
            width: 56px; height: 56px; flex-shrink: 0;
            border-radius: 10px; overflow: hidden;
            background: rgba(255,255,255,0.06);
            border: 2px solid var(--ac);
            display: flex; align-items: center; justify-content: center;
        }
        .effect-icon-wrap img { width: 100%; height: 100%; object-fit: contain; }
        .effect-icon-placeholder {
            font-size: 1.4rem; color: var(--ac);
            font-weight: 900; text-transform: uppercase;
        }

        .card-header-right { flex: 1; min-width: 0; }

        .effect-name {
            font-size: 1.05rem; font-weight: 800;
            color: #fff; text-transform: uppercase;
            letter-spacing: 0.5px; margin-bottom: 6px;
        }

        .tier-badges { display: flex; gap: 5px; flex-wrap: wrap; }
        .tier-badge {
            display: inline-block; padding: 2px 8px;
            border-radius: 4px; font-size: 0.75rem; font-weight: 700;
            background: var(--ac); color: #fff; cursor: default;
        }

        .hero-count {
            display: inline-flex; align-items: center; gap: 5px;
            background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
            padding: 3px 10px; border-radius: 20px;
            font-size: 0.78rem; font-weight: 600; color: rgba(255,255,255,0.7);
        }
        .hero-count.has-heroes { background: rgba(255,255,255,0.12); color: #fff; }

        .effect-description {
            color: rgba(255,255,255,0.75);
            font-size: 0.88rem; line-height: 1.6;
            flex: 1;
        }

        .effect-tiers {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding-top: 10px; display: flex; flex-direction: column; gap: 5px;
        }
        .effect-tier-row {
            display: flex; gap: 8px; align-items: flex-start;
            font-size: 0.82rem; color: rgba(255,255,255,0.65); line-height: 1.4;
        }
        .tier-label {
            flex-shrink: 0; min-width: 22px; font-weight: 700; color: var(--ac);
        }

        @media (max-width: 768px) {
            .effects-grid { grid-template-columns: 1fr; }
            .page-title { font-size: 2rem; }
            .tabs-nav { flex-direction: column; border-radius: 10px; }
            .tab-btn { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.08); }
            .tab-btn:last-child { border-bottom: none; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="effects-container">
    <a href="{{ path('app_heroes_index') }}" class="back-btn">← Retour aux héros</a>

    <div class="page-header">
        <h1 class="page-title">Buffs, Debuffs & Disables</h1>
        <p class="page-subtitle">Guide complet des effets de statut</p>
    </div>

    {# ── Onglets ── #}
    <div class="tabs-nav">
        <button class="tab-btn active" data-tab="buff">
            ✨ Buffs <span class="tab-count">{{ buffGroups|length }}</span>
        </button>
        <button class="tab-btn" data-tab="debuff">
            💀 Debuffs <span class="tab-count">{{ debuffGroups|length }}</span>
        </button>
        <button class="tab-btn" data-tab="disable">
            🚫 Disables <span class="tab-count">{{ disableGroups|length }}</span>
        </button>
    </div>

    {# ── Panneaux ── #}
    {% set sections = [
        { key: 'buffGroups',    type: 'buff',    panel: 'buff'    },
        { key: 'debuffGroups',  type: 'debuff',  panel: 'debuff'  },
        { key: 'disableGroups', type: 'disable', panel: 'disable' },
    ] %}

    {% for section in sections %}
        {% set groups = attribute(_context, section.key) %}
        <div class="tab-panel {{ loop.first ? 'active' : '' }}" id="panel-{{ section.panel }}">
            <div class="effects-grid">
                {% for group in groups %}
                <div class="effect-card {{ section.type }}">
                    <div class="card-header">
                        <div class="effect-icon-wrap">
                            {% if group.iconUrl %}
                                <img src="{{ group.iconUrl }}" alt="{{ group.name }}" loading="lazy"
                                     onerror="this.parentNode.innerHTML='<span class=effect-icon-placeholder>{{ group.name|slice(0,1) }}</span>'">
                            {% else %}
                                <span class="effect-icon-placeholder">{{ group.name|slice(0,1) }}</span>
                            {% endif %}
                        </div>
                        <div class="card-header-right">
                            <div class="effect-name">{{ group.name }}</div>
                            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
                                {% if group.tiers|length > 0 %}
                                    <div class="tier-badges">
                                        {% for tier, desc in group.tiers %}
                                            <span class="tier-badge" title="{{ desc }}">{{ tier }}</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                <span class="hero-count {{ group.heroCount > 0 ? 'has-heroes' : '' }}">
                                    {{ group.heroCount > 0 ? group.heroCount ~ ' heroes' : 'No current heroes' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    {% if group.description %}
                        <div class="effect-description">{{ group.description }}</div>
                    {% endif %}

                    {% if group.tiers|length > 1 %}
                        <div class="effect-tiers">
                            {% for tier, desc in group.tiers %}
                                <div class="effect-tier-row">
                                    <span class="tier-label">{{ tier }}</span>
                                    <span>{{ desc }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </div>
    {% endfor %}
</div>

<script>
document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('panel-' + tab).classList.add('active');
    });
});
</script>
{% endblock %}
