{% extends 'base.html.twig' %}

{% block title %}{{ hero.Name }} - Details{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('app') }}
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow-x: hidden;
        }

        /* ===== RARITY COLORS ===== */
        {# Legendary - Or/Jaune #}
        {% if hero.rarityEntity and (hero.rarityEntity.name == 'Legendary' or hero.rarityEntity.name == 'Légendaire') %}
            :root {
                --rarity-primary: #ffd700;
                --rarity-secondary: #ffed4e;
                --rarity-glow: rgba(255, 215, 0, 0.5);
                --rarity-bg: rgba(255, 215, 0, 0.1);
                --rarity-border: rgba(255, 215, 0, 0.3);
            }
        
        {# Epic - Violet #}
        {% elseif hero.rarityEntity and hero.rarityEntity.name == 'Epic' %}
            :root {
                --rarity-primary: #a855f7;
                --rarity-secondary: #c084fc;
                --rarity-glow: rgba(168, 85, 247, 0.5);
                --rarity-bg: rgba(168, 85, 247, 0.1);
                --rarity-border: rgba(168, 85, 247, 0.3);
            }
        
        {# Rare - Bleu #}
        {% elseif hero.rarityEntity and hero.rarityEntity.name == 'Rare' %}
            :root {
                --rarity-primary: #3b82f6;
                --rarity-secondary: #60a5fa;
                --rarity-glow: rgba(59, 130, 246, 0.5);
                --rarity-bg: rgba(59, 130, 246, 0.1);
                --rarity-border: rgba(59, 130, 246, 0.3);
            }
        
        {# Uncommon - Vert #}
        {% elseif hero.rarityEntity and hero.rarityEntity.name == 'Uncommon' %}
            :root {
                --rarity-primary: #10b981;
                --rarity-secondary: #34d399;
                --rarity-glow: rgba(16, 185, 129, 0.5);
                --rarity-bg: rgba(16, 185, 129, 0.1);
                --rarity-border: rgba(16, 185, 129, 0.3);
            }
        
        {# Common - Gris #}
        {% elseif hero.rarityEntity and hero.rarityEntity.name == 'Common' %}
            :root {
                --rarity-primary: #9ca3af;
                --rarity-secondary: #d1d5db;
                --rarity-glow: rgba(156, 163, 175, 0.5);
                --rarity-bg: rgba(156, 163, 175, 0.1);
                --rarity-border: rgba(156, 163, 175, 0.3);
            }
        
        {# Default - Cyan (fallback) #}
        {% else %}
            :root {
                --rarity-primary: #00ff88;
                --rarity-secondary: #00ccff;
                --rarity-glow: rgba(0, 255, 136, 0.5);
                --rarity-bg: rgba(0, 255, 136, 0.1);
                --rarity-border: rgba(0, 255, 136, 0.3);
            }
        {% endif %}

        /* Hero Detail Section */
        .hero-detail-section {
            position: relative;
            min-height: 100vh;
            background: 
                linear-gradient(135deg, rgba(10, 14, 39, 0.92) 0%, rgba(26, 31, 58, 0.92) 100%),
                url('{{ asset('images/castle-background.jpg') }}') center/cover no-repeat fixed;
            padding: 100px 0 50px 0;
        }

        .hero-detail-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 50%, var(--rarity-bg) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(0, 200, 255, 0.08) 0%, transparent 50%);
            pointer-events: none;
        }

        .container-custom {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 30px;
            position: relative;
            z-index: 2;
        }

        /* Back Button */
        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            background: rgba(255, 255, 255, 0.05);
            color: var(--rarity-primary);
            border: 1px solid var(--rarity-border);
            border-radius: 20px;
            text-decoration: none;
            font-weight: 600;
            margin-bottom: 30px;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .back-btn:hover {
            background: var(--rarity-bg);
            border-color: var(--rarity-primary);
            transform: translateX(-5px);
            color: var(--rarity-primary);
        }

        /* Main Hero Card */
        .hero-card-detail {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid var(--rarity-border);
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        }

        /* Hero Header with Image */
        .hero-header-section {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 0;
        }

        .hero-image-container {
            position: relative;
            height: 480px;
            overflow: hidden;
        }

        .hero-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-image-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 24px;
            background: linear-gradient(to top, rgba(0, 0, 0, 0.95), transparent);
        }

        .hero-main-title {
            color: var(--rarity-primary);
            font-size: 2rem;
            font-weight: 900;
            margin: 0;
            text-transform: uppercase;
            text-shadow: 0 2px 12px var(--rarity-glow);
        }

        .hero-id {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.9rem;
        }

        .leader-badge-large {
            position: absolute;
            top: 15px;
            right: 15px;
            background: linear-gradient(135deg, #ffd700 0%, #ffed4e 100%);
            color: #0a0e27;
            padding: 10px 20px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.95rem;
            box-shadow: 0 6px 20px rgba(255, 215, 0, 0.5);
            z-index: 5;
        }

        /* Rarity Display */
        .rarity-display {
            color: var(--rarity-primary);
            font-size: 1rem;
            font-weight: 700;
            margin-top: 8px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
            background: rgba(0, 0, 0, 0.4);
            padding: 5px 10px;
            border-radius: 6px;
            display: inline-block;
            border: 2px solid var(--rarity-border);
        }

        /* Hero Info Section */
        .hero-info-section {
            padding: 30px;
        }

        /* Badges avec icônes */
        .hero-badges-main {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 28px;
            padding: 8px 0;
        }

        .badge-large {
            display: inline-flex;
            align-items: center;
            padding: 10px 20px;
            border-radius: 24px;
            font-size: 0.95rem;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .badge-large:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
        }

        .badge-icon {
            width: 24px;
            height: 24px;
            object-fit: contain;
            margin-right: 8px;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
            transition: transform 0.3s ease;
        }

        .badge-large:hover .badge-icon {
            transform: scale(1.1) rotate(5deg);
        }

        .badge-faction {
            background: linear-gradient(135deg, #a855f7 0%, #ec4899 100%);
            color: #ffffff;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .badge-type {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            color: #ffffff;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .badge-affinity {
            background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
            color: #ffffff;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .badge-allegiance {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.2) 100%);
            color: #ffffff;
            border: 2px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(10px);
        }

        /* Weapons and Leader Grid */
        .weapons-leader-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .info-box {
            padding: 16px;
            border-radius: 14px;
            border: 2px solid;
        }

        .info-box-weapons {
            background: rgba(59, 130, 246, 0.1);
            border-color: rgba(59, 130, 246, 0.5);
        }

        .info-box-leader {
            background: rgba(255, 215, 0, 0.1);
            border-color: rgba(255, 215, 0, 0.5);
        }

        .info-box-title {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-box-weapons .info-box-title {
            color: #3b82f6;
        }

        .info-box-leader .info-box-title {
            color: #ffd700;
        }

        .weapon-item {
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            padding: 8px;
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .weapon-item:hover {
            background: rgba(59, 130, 246, 0.2);
            transform: translateX(3px);
        }

        .weapon-image {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            overflow: hidden;
            background: rgba(59, 130, 246, 0.2);
            border: 2px solid rgba(59, 130, 246, 0.5);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .weapon-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .weapon-number {
            background: rgba(59, 130, 246, 0.5);
            color: #ffffff;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

        .leader-content {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .leader-image {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            overflow: hidden;
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.3), rgba(255, 215, 0, 0.1));
            border: 3px solid rgba(255, 215, 0, 0.6);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
        }

        .leader-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .leader-text {
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.5;
            font-size: 0.95rem;
            flex: 1;
        }

        /* Imprints Section */
        .imprints-section {
            margin-bottom: 24px;
        }

        .section-title {
            color: var(--rarity-primary);
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .imprints-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
        }

        .imprint-box {
            padding: 12px;
            background: var(--rarity-bg);
            border: 1px solid var(--rarity-border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.3s ease;
        }

        .imprint-box:hover {
            background: var(--rarity-bg);
            border-color: var(--rarity-primary);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px var(--rarity-glow);
        }

        .imprint-image {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            overflow: hidden;
            background: linear-gradient(135deg, var(--rarity-bg), var(--rarity-bg));
            border: 2px solid var(--rarity-primary);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px var(--rarity-glow);
        }

        .imprint-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .imprint-content {
            flex: 1;
        }

        .imprint-level {
            background: var(--rarity-border);
            color: #ffffff;
            padding: 3px 10px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.8rem;
            display: inline-block;
            margin-bottom: 6px;
        }

        .imprint-text {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.85rem;
            line-height: 1.4;
        }

        /* Sets Triangle Display */
        .sets-triangle-container {
            padding: 20px;
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.3) 100%);
            border: 2px solid var(--rarity-border);
            border-radius: 16px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
            margin-bottom: 20px;
        }

        .sets-triangle-title {
            color: var(--rarity-primary);
            font-size: 0.9rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 16px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .set-item-triangle {
            position: relative;
            background: linear-gradient(135deg, var(--rarity-bg) 0%, var(--rarity-bg) 100%);
            border: 2px solid var(--rarity-border);
            border-radius: 12px;
            padding: 10px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .set-item-triangle:hover {
            transform: scale(1.05) translateY(-3px);
            border-color: var(--rarity-primary);
            box-shadow: 0 10px 30px var(--rarity-glow);
        }

        .set-item-triangle img {
            width: 55px;
            height: 55px;
            object-fit: contain;
            filter: drop-shadow(0 3px 10px var(--rarity-glow));
        }

        /* Equipment Section */
        .equipment-section {
            margin-bottom: 24px;
        }

        .equipment-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .equipment-item {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
            border: 2px solid rgba(59, 130, 246, 0.3);
            border-radius: 14px;
            padding: 16px;
            transition: all 0.3s ease;
        }

        .equipment-item:hover {
            transform: translateY(-2px);
            border-color: rgba(59, 130, 246, 0.6);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.3);
        }

        .equipment-content {
            flex: 1;
        }

        .equipment-name {
            color: #3b82f6;
            font-weight: 700;
            font-size: 1rem;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .equipment-main-stat {
            color: var(--rarity-primary);
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: 12px;
            padding: 8px 12px;
            background: var(--rarity-bg);
            border-left: 3px solid var(--rarity-primary);
            border-radius: 6px;
        }

        .equipment-substats {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .equipment-substat {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.9rem;
            padding: 6px 10px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 5px;
            border-left: 2px solid rgba(59, 130, 246, 0.5);
            line-height: 1.4;
        }

        .equipment-substat::before {
            content: '▸';
            color: #3b82f6;
            margin-right: 6px;
            font-size: 0.75rem;
        }

        /* Action Buttons */
        .action-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-edit {
            padding: 12px 28px;
            background: linear-gradient(135deg, var(--rarity-primary) 0%, var(--rarity-secondary) 100%);
            color: #0a0e27;
            border: none;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-edit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px var(--rarity-glow);
            color: #0a0e27;
        }

        .btn-delete {
            padding: 12px 28px;
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid #ef4444;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-delete:hover {
            background: rgba(239, 68, 68, 0.3);
            transform: translateY(-2px);
        }

        /* Skills Section */
        .skills-section {
            padding: 30px;
            background: rgba(0, 0, 0, 0.2);
            border-top: 1px solid var(--rarity-border);
        }

        .skills-title {
            color: var(--rarity-primary);
            font-size: 1.6rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-shadow: 0 2px 12px var(--rarity-glow);
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
            gap: 20px;
        }

        .skill-card {
            padding: 0;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 14px;
            backdrop-filter: blur(10px);
            overflow: hidden;
            border: 2px solid;
            transition: all 0.3s ease;
        }

        .skill-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
        }

        .skill-card-base {
            border-color: #3b82f6;
        }

        .skill-card-core {
            border-color: #10b981;
        }

        .skill-card-ultimate {
            border-color: #ef4444;
        }

        .skill-card-passive {
            border-color: #eab308;
        }

        /* Header du skill */
        .skill-header {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .skill-card-base .skill-header {
            background: rgba(59, 130, 246, 0.15);
        }

        .skill-card-core .skill-header {
            background: rgba(16, 185, 129, 0.15);
        }

        .skill-card-ultimate .skill-header {
            background: rgba(239, 68, 68, 0.15);
        }

        .skill-card-passive .skill-header {
            background: rgba(234, 179, 8, 0.15);
        }

        .skill-title-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .skill-badge {
            padding: 6px 14px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
        }

        .skill-badge-base {
            background: #3b82f6;
            color: #fff;
        }

        .skill-badge-core {
            background: #10b981;
            color: #fff;
        }

        .skill-badge-ultimate {
            background: #ef4444;
            color: #fff;
        }

        .skill-badge-passive {
            background: #eab308;
            color: #0a0e27;
        }

        .skill-name {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .skill-card-base .skill-name {
            color: #3b82f6;
        }

        .skill-card-core .skill-name {
            color: #10b981;
        }

        .skill-card-ultimate .skill-name {
            color: #ef4444;
        }

        .skill-card-passive .skill-name {
            color: #eab308;
        }

        /* Cooldown and Divinity badges */
        .skill-meta-badges {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .cooldown-badge,
        .divinity-badge {
            background: rgba(0, 0, 0, 0.5);
            padding: 6px 12px;
            border-radius: 16px;
            font-weight: 600;
            font-size: 0.85rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 5px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.4);
        }

        .cooldown-badge {
            background: rgba(6, 182, 212, 0.2);
            border: 1px solid rgba(6, 182, 212, 0.5);
            color: #06b6d4;
        }

        .cooldown-badge i {
            font-size: 0.9rem;
        }

        .divinity-badge.divinity-initial {
            background: linear-gradient(135deg, rgba(138, 43, 226, 0.6) 0%, rgba(75, 0, 130, 0.6) 100%);
            border: 2px solid rgba(138, 43, 226, 0.8);
        }

        .divinity-badge.divinity-cost {
            background: linear-gradient(135deg, rgba(255, 20, 147, 0.6) 0%, rgba(199, 21, 133, 0.6) 100%);
            border: 2px solid rgba(255, 20, 147, 0.8);
        }

        /* Body du skill */
        .skill-body {
            padding: 20px;
        }

        /* Description principale */
        .skill-description {
            color: rgba(255, 255, 255, 0.95);
            line-height: 1.7;
            font-size: 0.95rem;
            margin-bottom: 0;
            padding: 14px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        /* ✅ STYLES POUR LES EFFETS (BUFFS/DEBUFFS/DISABLE) */
        .skill-effect {
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 4px;
            cursor: help;
            transition: all 0.2s ease;
            display: inline-block;
            border: 1px solid;
        }

        /* 🔵 BUFFS - BLEU */
        .skill-effect.effect-buff {
            color: #3b82f6;
            background: rgba(59, 130, 246, 0.15);
            border-color: rgba(59, 130, 246, 0.4);
        }

        .skill-effect.effect-buff:hover {
            background: rgba(59, 130, 246, 0.25);
            border-color: #3b82f6;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.4);
        }

        /* 🔴 DEBUFFS - ROUGE */
        .skill-effect.effect-debuff {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.4);
        }

        .skill-effect.effect-debuff:hover {
            background: rgba(239, 68, 68, 0.25);
            border-color: #ef4444;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
        }

        /* 🟣 DISABLES - VIOLET */
        .skill-effect.effect-disable {
            color: #a855f7;
            background: rgba(168, 85, 247, 0.15);
            border-color: rgba(168, 85, 247, 0.4);
        }

        .skill-effect.effect-disable:hover {
            background: rgba(168, 85, 247, 0.25);
            border-color: #a855f7;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(168, 85, 247, 0.4);
        }

        /* ===== TOOLTIP (DESKTOP) ===== */
        .skill-tooltip {
            position: fixed;
            width: 300px;
            background: linear-gradient(135deg, rgba(10, 14, 39, 0.98) 0%, rgba(26, 31, 58, 0.98) 100%);
            backdrop-filter: blur(20px);
            border-radius: 12px;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.9);
            z-index: 10000;
            pointer-events: none;
            display: none;
            border: 2px solid;
            overflow: hidden;
        }

        .skill-tooltip-header {
            padding: 12px 16px;
            font-weight: 700;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        }

        .skill-tooltip-header.buff {
            background: rgba(59, 130, 246, 0.25);
            color: #60a5fa;
        }

        .skill-tooltip-header.debuff {
            background: rgba(239, 68, 68, 0.25);
            color: #fca5a5;
        }

        .skill-tooltip-header.disable {
            background: rgba(168, 85, 247, 0.25);
            color: #d8b4fe;
        }

        .skill-tooltip-body {
            padding: 14px 16px;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.6;
        }

        .skill-tooltip.buff { border-color: #3b82f6; }
        .skill-tooltip.debuff { border-color: #ef4444; }
        .skill-tooltip.disable { border-color: #a855f7; }

        /* Weapon / Set styles reuse the same modal visual language */
        .skill-tooltip.weapon { border-color: rgba(59,130,246,0.6); }
        .skill-tooltip.set { border-color: rgba(255,215,0,0.6); }

        .skill-modal-header.weapon { background: rgba(59,130,246,0.18); color: #60a5fa; }
        .skill-modal-header.set { background: rgba(255,215,0,0.08); color: #ffd700; }

        /* ===== MODAL (MOBILE) ===== */
        .skill-modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            z-index: 9999;
            display: flex;
            align-items: flex-end;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .skill-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .skill-modal {
            width: 100%;
            background: linear-gradient(135deg, rgba(10, 14, 39, 0.98) 0%, rgba(26, 31, 58, 0.98) 100%);
            border-radius: 20px 20px 0 0;
            box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.8);
            max-height: 80vh;
            overflow-y: auto;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                transform: translateY(100%);
            }
            to {
                transform: translateY(0);
            }
        }

        .skill-modal-header {
            padding: 20px;
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            backdrop-filter: blur(10px);
        }

        .skill-modal-header.buff {
            background: rgba(59, 130, 246, 0.25);
            color: #60a5fa;
        }

        .skill-modal-header.debuff {
            background: rgba(239, 68, 68, 0.25);
            color: #fca5a5;
        }

        .skill-modal-header.disable {
            background: rgba(168, 85, 247, 0.25);
            color: #d8b4fe;
        }

        .skill-modal-close {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #ffffff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            flex-shrink: 0;
        }

        .skill-modal-close:active {
            background: rgba(255, 255, 255, 0.2);
            transform: scale(0.95);
        }

        .skill-modal-body {
            padding: 20px;
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.85);
            line-height: 1.7;
        }

        /* Accordion styles */
        .accordion-item {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid var(--rarity-border);
            border-radius: 12px;
            margin-bottom: 1rem;
        }

        .accordion-button {
            background: var(--rarity-bg);
            color: var(--rarity-primary);
            font-weight: 700;
            border-radius: 12px;
            padding: 1rem 1.5rem;
        }

        .accordion-button:not(.collapsed) {
            background: var(--rarity-bg);
            color: var(--rarity-primary);
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: 0 0 0 4px var(--rarity-glow);
            border-color: var(--rarity-primary);
        }

        .accordion-body {
            background: rgba(0, 0, 0, 0.2);
            padding: 1.5rem;
            border-radius: 0 0 12px 12px;
            color: rgba(255, 255, 255, 0.9);
        }

        /* Bonuses Section */
        .bonuses-section {
            padding: 30px;
            background: var(--rarity-bg);
            border-top: 2px solid var(--rarity-border);
        }

        .bonuses-title {
            color: var(--rarity-primary);
            font-size: 1.5rem;
            font-weight: 700;
            text-align: center;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            text-shadow: 0 2px 12px var(--rarity-glow);
        }

        .bonuses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 20px;
        }

        .bonus-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 24px;
            border-radius: 14px;
            border: 2px solid var(--rarity-border);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .bonus-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px var(--rarity-glow);
        }

        .bonus-card-title {
            color: var(--rarity-primary);
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Bonus Lists */
        .bonus-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .bonus-list li {
            color: rgba(255, 255, 255, 0.9);
            padding: 10px 0 10px 26px;
            position: relative;
            line-height: 1.6;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .bonus-list li:last-child {
            border-bottom: none;
        }

        .bonus-list li::before {
            content: '⭐';
            position: absolute;
            left: 0;
            color: var(--rarity-primary);
            font-weight: 700;
            font-size: 1.2rem;
        }

        /* Video Section */
        .video-section {
            padding: 30px;
            background: rgba(0, 0, 0, 0.2);
            border-top: 1px solid rgba(255, 0, 0, 0.3);
        }

        .video-container {
            position: relative;
            padding-bottom: 56.25%;
            height: 0;
            overflow: hidden;
            border-radius: 14px;
            background: rgba(0, 0, 0, 0.5);
            border: 2px solid rgba(255, 0, 0, 0.5);
            box-shadow: 0 8px 32px rgba(255, 0, 0, 0.3);
        }

        .video-container iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 12px;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .hero-header-section {
                grid-template-columns: 1fr;
            }

            .hero-image-container {
                height: 350px;
            }

            .skills-grid,
            .bonuses-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .container-custom {
                padding: 0 16px;
            }

            .hero-main-title {
                font-size: 1.6rem;
            }

            .weapons-leader-grid {
                grid-template-columns: 1fr;
            }

            .imprints-grid {
                grid-template-columns: 1fr;
            }

            .equipment-grid {
                grid-template-columns: 1fr;
            }

            .action-buttons {
                flex-direction: column;
            }

            .btn-edit,
            .btn-delete {
                width: 100%;
                justify-content: center;
            }

            .skill-meta-badges {
                flex-direction: column;
                align-items: flex-start;
            }

            .set-item-triangle img {
                width: 45px;
                height: 45px;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero-detail-section">
    <div class="container-custom">
        <!-- Back Button -->
        <a href="{{ path('app_heroes_index') }}" class="back-btn">
            <i class="fas fa-arrow-left"></i> Back to Gallery
        </a>

        <div class="hero-card-detail">
            <!-- Hero Header with Image and Info -->
            <div class="hero-header-section">
                <!-- Hero Image -->
                <div class="hero-image-container">
                    {% if hero.imageUrl %}
                        <img src="{{ hero.imageUrl }}" alt="{{ hero.Name }}">
                    {% else %}
                        <img src="https://via.placeholder.com/400x600/667eea/ffffff?text={{ hero.Name|url_encode }}" alt="{{ hero.Name }}">
                    {% endif %}
                    
                    <div class="hero-image-overlay">
                        <h1 class="hero-main-title">{{ hero.Name }}</h1>
                        {% if hero.rarityEntity %}
                            <div class="rarity-display">{{ hero.rarityEntity.name }}</div>
                        {% endif %}
                    </div>
                </div>

                <!-- Hero Info -->
                <div class="hero-info-section">
                    <!-- Main Badges avec icônes -->
                    <div class="hero-badges-main">
                        {% if hero.factionEntity %}
                            <span class="badge-large badge-faction">
                                {% set hasImage = false %}
                                {% set imageSource = null %}
                                {% if hero.factionEntity.iconUrl is defined and hero.factionEntity.iconUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.factionEntity.iconUrl %}
                                {% elseif hero.factionEntity.imageUrl is defined and hero.factionEntity.imageUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.factionEntity.imageUrl %}
                                {% endif %}
                                {% if hasImage and imageSource %}
                                    <img src="{{ imageSource }}" alt="{{ hero.factionEntity.name }}" class="badge-icon" loading="lazy" onerror="this.style.display='none'">
                                {% endif %}
                                {{ hero.factionEntity.name }}
                            </span>
                        {% endif %}

                        {% if hero.typeEntity %}
                            <span class="badge-large badge-type">
                                {% set hasImage = false %}
                                {% set imageSource = null %}
                                {% if hero.typeEntity.iconUrl is defined and hero.typeEntity.iconUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.typeEntity.iconUrl %}
                                {% elseif hero.typeEntity.imageUrl is defined and hero.typeEntity.imageUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.typeEntity.imageUrl %}
                                {% endif %}
                                {% if hasImage and imageSource %}
                                    <img src="{{ imageSource }}" alt="{{ hero.typeEntity.name }}" class="badge-icon" loading="lazy" onerror="this.style.display='none'">
                                {% endif %}
                                {{ hero.typeEntity.name }}
                            </span>
                        {% endif %}

                        {% if hero.affinityEntity %}
                            <span class="badge-large badge-affinity">
                                {% set hasImage = false %}
                                {% set imageSource = null %}
                                {% if hero.affinityEntity.iconUrl is defined and hero.affinityEntity.iconUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.affinityEntity.iconUrl %}
                                {% elseif hero.affinityEntity.imageUrl is defined and hero.affinityEntity.imageUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.affinityEntity.imageUrl %}
                                {% endif %}
                                {% if hasImage and imageSource %}
                                    <img src="{{ imageSource }}" alt="{{ hero.affinityEntity.name }}" class="badge-icon" loading="lazy" onerror="this.style.display='none'">
                                {% endif %}
                                {{ hero.affinityEntity.name }}
                            </span>
                        {% endif %}

                        {% if hero.allegianceEntity %}
                            <span class="badge-large badge-allegiance">
                                {% set hasImage = false %}
                                {% set imageSource = null %}
                                {% if hero.allegianceEntity.iconUrl is defined and hero.allegianceEntity.iconUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.allegianceEntity.iconUrl %}
                                {% elseif hero.allegianceEntity.imageUrl is defined and hero.allegianceEntity.imageUrl %}
                                    {% set hasImage = true %}
                                    {% set imageSource = hero.allegianceEntity.imageUrl %}
                                {% endif %}
                                {% if hasImage and imageSource %}
                                    <img src="{{ imageSource }}" alt="{{ hero.allegianceEntity.name }}" class="badge-icon" loading="lazy" onerror="this.style.display='none'">
                                {% endif %}
                                {{ hero.allegianceEntity.name }}
                            </span>
                        {% endif %}
                    </div>

                    <!-- Stats interactives -->
                    {% if hero.statHp or hero.statAtk %}
                    <div style="margin-bottom: 24px; background: rgba(0,0,0,0.3); border: 1px solid var(--rarity-border); border-radius: 12px; padding: 16px;">

                        <!-- Header avec label rank/level -->
                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;">
                            <div style="font-size:0.75rem; font-weight:700; color: var(--rarity-primary); text-transform:uppercase; letter-spacing:1px;">Base Stats</div>
                            <div id="statRankLabel" style="font-size:0.8rem; font-weight:700; color: var(--rarity-primary);">Rank 1 / Level 1</div>
                        </div>

                        <!-- Slider level -->
                        <div style="margin-bottom:16px;">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span style="font-size:0.75rem; color:rgba(255,255,255,0.4);">1</span>
                                <input type="range" id="statLevelSlider" min="1" max="60" value="1"
                                    style="flex:1; accent-color: var(--rarity-primary); cursor:pointer; height:4px;">
                                <span style="font-size:0.75rem; color:rgba(255,255,255,0.4);">60</span>
                            </div>
                        </div>

                        <!-- Grille des stats -->
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px;">
                            <div class="stat-box" data-stat="hp" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-heart" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">HP</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statHp }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="atk" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-sword" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">ATK</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statAtk }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="def" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-shield" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">DEF</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statDef }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="spd" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-wind" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">SPD</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statSpd }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="init" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-bolt" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">INIT</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statInit }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="acc" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-crosshairs" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">ACC</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statAcc }}</div></div>
                            </div>
                            <div class="stat-box" data-stat="res" style="display:flex; align-items:center; gap:10px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 8px; padding: 10px 12px;">
                                <i class="fas fa-circle-half-stroke" style="color: var(--rarity-primary); font-size:1rem; width:16px; text-align:center;"></i>
                                <div><div style="font-size:0.7rem; color:rgba(255,255,255,0.45); text-transform:uppercase; letter-spacing:0.5px;">RES</div><div class="stat-val" style="font-size:1rem; font-weight:700; color:#fff;">{{ hero.statRes }}</div></div>
                            </div>
                        </div>
                    </div>

                    <script>
                    (function() {
                        const BASE = {
                            hp:   {{ hero.statHp ?? 0 }},
                            atk:  {{ hero.statAtk ?? 0 }},
                            def:  {{ hero.statDef ?? 0 }},
                            spd:  {{ hero.statSpd ?? 0 }},
                            init: {{ hero.statInit ?? 0 }},
                            acc:  {{ hero.statAcc ?? 0 }},
                            res:  {{ hero.statRes ?? 0 }},
                        };
                        const SCALING = {{ hero.statScalingJson ? hero.statScalingJson|raw : '[]' }};
                        // HP, ATK, DEF seuls scalent avec le level (confirmé via l'API)
                        const LEVEL_SCALES = ['hp', 'atk', 'def'];
                        // Facteur au level 60 (dérivé empiriquement : constant pour tous les héros)
                        const MAX_FACTOR = 9.2453;

                        function levelFactor(level) {
                            return 1 + (MAX_FACTOR - 1) * (level - 1) / 59;
                        }

                        function rankFromLevel(level) {
                            return Math.min(Math.ceil(level / 10), 6);
                        }

                        function calcStats(level) {
                            const rank = rankFromLevel(level);
                            const s = Object.assign({}, BASE);

                            // Appliquer les bonus d'ascension des rangs précédents
                            for (const b of SCALING) {
                                if (b.rank < rank) {
                                    const key = b.stat.toLowerCase();
                                    if (key in s) {
                                        if (b.multiplier) s[key] = s[key] * (1 + b.multiplier);
                                        if (b.flat_bonus)  s[key] = s[key] + b.flat_bonus;
                                    }
                                }
                            }

                            // Scaling par level sur HP/ATK/DEF
                            const lf = levelFactor(level);
                            for (const k of LEVEL_SCALES) {
                                if (s[k]) s[k] = s[k] * lf;
                            }

                            for (const k in s) s[k] = Math.round(s[k]);
                            return s;
                        }

                        const slider = document.getElementById('statLevelSlider');
                        const label  = document.getElementById('statRankLabel');

                        function update() {
                            const level = parseInt(slider.value);
                            const rank  = rankFromLevel(level);
                            label.textContent = 'Rank ' + rank + ' / Level ' + level;
                            const stats = calcStats(level);
                            document.querySelectorAll('.stat-box').forEach(box => {
                                const key = box.dataset.stat;
                                if (key in stats) box.querySelector('.stat-val').textContent = stats[key];
                            });
                        }

                        slider.addEventListener('input', update);
                    })();
                    </script>
                    {% endif %}

                    <!-- Weapons and Leader -->
                    <div class="weapons-leader-grid">
                        {% if hero.weapons|length > 0 %}
                            <div class="info-box info-box-weapons">
                                <div class="info-box-title">⚔️ Recommended Weapons</div>
                                {% for weapon in hero.weapons %}
                                    <div class="weapon-item" tabindex="0" data-name="{{ weapon.name|e('html_attr') }}" data-description="{{ weapon.description ? (weapon.description|striptags)|e('html_attr') : '' }}">
                                        {% if weapon.imageUrl %}
                                            <div class="weapon-image">
                                                <img src="{{ weapon.imageUrl }}" alt="{{ weapon.name }}">
                                            </div>
                                        {% else %}
                                            <span class="weapon-number">{{ loop.index }}</span>
                                        {% endif %}
                                        <div style="flex: 1;">
                                            <div style="font-weight: 700; color: #ffffff;">{{ weapon.name }}</div>
                                            {% if weapon.mainStat %}
                                                <div style="font-size: 0.8rem; color: rgba(255, 255, 255, 0.6);">{{ weapon.mainStat|upper }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        {% if hero.leaderEntity %}
                            {% set statColors = {
                                'HP':    '#22c55e',
                                'ATK':   '#ef4444',
                                'DEF':   '#3b82f6',
                                'SPD':   '#eab308',
                                'FTH':   '#f97316',
                                'ACC':   '#a855f7',
                                'RES':   '#06b6d4',
                                'CDMG':  '#ec4899',
                                'CRATE': '#f43f5e',
                            } %}
                            {% set statName = hero.leaderEntity.name %}
                            {% set statColor = statColors[statName] ?? '#ffd700' %}
                            <div class="info-box info-box-leader">
                                <div class="info-box-title">👑 Leader Aura</div>
                                <div class="leader-content">
                                    <div class="leader-image" style="background: linear-gradient(135deg, {{ statColor }}33, {{ statColor }}11); border-color: {{ statColor }}99; box-shadow: 0 4px 15px {{ statColor }}44;">
                                        {% if hero.leaderEntity.imageUrl %}
                                            <img src="{{ hero.leaderEntity.imageUrl }}" alt="{{ statName }}"
                                                 onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" style="width:100%;height:100%;object-fit:contain;">
                                            <span style="display:none;font-size:0.75rem;font-weight:900;color:{{ statColor }};align-items:center;justify-content:center;">{{ statName }}</span>
                                        {% else %}
                                            <span style="font-size:0.75rem;font-weight:900;color:{{ statColor }};">{{ statName }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="leader-text">
                                        <div style="font-weight: 700; color: {{ statColor }}; margin-bottom: 4px;">{{ statName }} Leader</div>
                                        {% if hero.leaderValue %}
                                            <div style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.8);">{{ hero.leaderValue }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    <!-- Signature Imprint (champ texte simple) -->
                    {% if hero.imprint %}
                        <div class="imprints-section">
                            <h3 class="section-title">💎 Signature Imprint</h3>
                            <div class="imprint-box">
                                <div class="imprint-image">
                                    {% if hero.imageUrl %}
                                        <img src="{{ hero.imageUrl }}" alt="{{ hero.Name }}" style="border-radius: 50%;">
                                    {% else %}
                                        <i class="fas fa-gem" style="font-size: 1.5rem; color: var(--rarity-primary);"></i>
                                    {% endif %}
                                </div>
                                <div class="imprint-content">
                                    <span class="imprint-level">{{ hero.Name }} - Signature</span>
                                    <div class="imprint-text">{{ hero.imprint }}</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Recommended Imprints (relation ManyToMany) -->
                    {% if hero.imprints|length > 0 %}
                        <div class="imprints-section" style="margin-top: 24px;">
                            <h3 class="section-title">💎 Recommended Imprints</h3>
                            <div class="imprints-grid">
                                {% for imprint in hero.imprints %}
                                    <div class="imprint-box">
                                        {% if imprint.imageUrl %}
                                            <div class="imprint-image">
                                                <img src="{{ imprint.imageUrl }}" alt="{{ imprint.name }}">
                                            </div>
                                        {% else %}
                                            <div class="imprint-image">
                                                <i class="fas fa-star" style="font-size: 1.5rem; color: var(--rarity-primary);"></i>
                                            </div>
                                        {% endif %}
                                        <div class="imprint-content">
                                            <span class="imprint-level">{{ imprint.name }}</span>
                                            {% if imprint.description %}
                                                <div class="imprint-text">{{ imprint.description }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Recommended Sets -->
                    {% if hero.recommendedSets|length > 0 %}
                        <div class="equipment-section">
                            <h3 class="section-title">⚡ Recommended Sets</h3>
                            <div class="sets-triangle-container">
                                <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-bottom: 15px;">
                                    {% for set in hero.recommendedSets %}
                                        <div class="set-item-triangle" tabindex="0" data-name="{{ set.name|e('html_attr') }}" data-description="{{ set.effect ? (set.effect|striptags)|e('html_attr') : '' }}">
                                            {% if set.imageUrl %}
                                                <img src="{{ set.imageUrl }}" alt="{{ set.name }}">
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                                <div style="text-align: center;">
                                    {% for set in hero.recommendedSets %}
                                        <span style="display: inline-block; background: var(--rarity-bg); color: var(--rarity-primary); padding: 5px 12px; border-radius: 8px; margin: 3px; font-size: 0.85rem; font-weight: 600;">
                                            {{ set.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    <!-- Recommended Armor -->
                    {% if hero.armors|length > 0 %}
                        <div class="equipment-section">
                            <h3 class="section-title">🛡️ Recommended Armor</h3>
                            <div class="equipment-grid">
                                {% for armor in hero.armors %}
                                    <div class="equipment-item">
                                        <div class="equipment-content">
                                            <div class="equipment-name">{{ armor.slot|title }}</div>
                                            <div class="equipment-main-stat">{{ armor.name }}</div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    <!-- Action Buttons -->
                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="action-buttons">
                            <a href="{{ path('app_heroes_edit', {slug: hero.slug}) }}" class="btn-edit">
                                <i class="fas fa-edit"></i> Edit Hero
                            </a>
                            {% include 'heroes/_delete_form.html.twig' %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Skills Section -->
            <div class="skills-section">
                <h2 class="skills-title">⚡ Skills & Abilities</h2>
                <div class="skills-grid">
                    {% set skillDefs = [
                        { field: hero.base,     type: 'basic',   badge: 'Basic',    badgeClass: 'base',    label: 'Basic' },
                        { field: hero.core,     type: 'core',    badge: 'Core',     badgeClass: 'core',    label: 'Core' },
                        { field: hero.ultimate, type: 'ultimate',badge: 'Ultimate', badgeClass: 'ultimate', label: 'Ultimate' },
                        { field: hero.passive,  type: 'passive', badge: 'P',  badgeClass: 'passive', label: 'Passive' },
                    ] %}

                    {% for skill in skillDefs %}
                        {% if skill.field %}
                            {% set parts = skill.field|split('|||', 4) %}
                            {% set abilityName = parts[0] %}
                            {% set abilityDesc = parts[1] ?? skill.field %}
                            {% set abilityIcon = parts[2] ?? '' %}
                            {% set abilityCooldown = parts[3] ?? '' %}
                            <div class="skill-card skill-card-{{ skill.badgeClass }}">
                                <div class="skill-header">
                                    <div class="skill-title-wrapper">
                                        {% if abilityIcon %}
                                            <img src="{{ abilityIcon }}" alt="{{ abilityName }}"
                                                 style="width:42px;height:42px;border-radius:8px;object-fit:cover;border:2px solid currentColor;flex-shrink:0;"
                                                 onerror="this.style.display='none'">
                                        {% endif %}
                                        <span class="skill-badge skill-badge-{{ skill.badgeClass }}">{{ skill.badge }}</span>
                                        <span class="skill-name">{{ abilityName ?: skill.label }}</span>
                                    </div>
                                    <div class="skill-meta-badges">
                                        {% if abilityCooldown %}
                                            <div class="cooldown-badge"><i class="fas fa-clock"></i> {{ abilityCooldown }} turn{{ abilityCooldown != '1' ? 's' : '' }}</div>
                                        {% endif %}
                                        {% if skill.type == 'ultimate' %}
                                            {% if hero.InitialDivinity %}
                                                <div class="divinity-badge divinity-initial">Initial: {{ hero.InitialDivinity }}</div>
                                            {% endif %}
                                            {% if hero.DivinityCost %}
                                                <div class="divinity-badge divinity-cost">Cost: {{ hero.DivinityCost }}</div>
                                            {% endif %}
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="skill-body">
                                    <div class="skill-description">{{ abilityDesc|parse_effects|raw }}</div>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

            {# Skill Level Upgrades et Skill Awakenings non utilisés — données non renseignées via API #}

            <!-- Bonuses Section -->
            {% if hero.awakeningBonuses or hero.ascensionBonuses %}
                <div class="bonuses-section">
                    <h2 class="bonuses-title">🎁 Bonuses</h2>
                    <div class="bonuses-grid">
                        <!-- Awakening Bonuses -->
                        {% if hero.awakeningBonuses %}
                            <div class="bonus-card">
                                <div class="bonus-card-title">⭐ Awakening Bonuses</div>
                                <ul class="bonus-list">
                                    {% set awakeningLines = hero.awakeningBonuses|split('\n') %}
                                    {% for line in awakeningLines %}
                                        {% if line|trim %}
                                            <li>{{ line|trim }}</li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <!-- Ascension Bonuses -->
                        {% if hero.ascensionBonuses %}
                            <div class="bonus-card">
                                <div class="bonus-card-title">🏆 Ascension Bonuses</div>
                                <ul class="bonus-list">
                                    {% set ascensionLines = hero.ascensionBonuses|split('\n') %}
                                    {% for line in ascensionLines %}
                                        {% if line|trim %}
                                            <li>{{ line|trim }}</li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            <!-- Video Section -->
            {% if hero.videosUrl %}
                <div class="video-section">
                    <h2 class="section-title">🎥 Video Guide</h2>
                    <div class="video-container">
                        <iframe src="{{ hero.videosUrl }}" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Evite double init si la page ré-exécute le script
      if (window.__skillTooltipInitialized) return;
      window.__skillTooltipInitialized = true;

      const isTouch =
        ('ontouchstart' in window) ||
        (navigator.maxTouchPoints > 0) ||
        (navigator.msMaxTouchPoints > 0);

      // ---------- DOM singletons ----------
      let tooltip = document.querySelector('.skill-tooltip');
      if (!tooltip) {
        tooltip = document.createElement('div');
        tooltip.className = 'skill-tooltip';
        tooltip.innerHTML = `
          <div class="skill-tooltip-header"></div>
          <div class="skill-tooltip-body"></div>
        `;
        document.body.appendChild(tooltip);
      }

      let modalOverlay = document.querySelector('.skill-modal-overlay');
      if (!modalOverlay) {
        modalOverlay = document.createElement('div');
        modalOverlay.className = 'skill-modal-overlay';
        modalOverlay.innerHTML = `
          <div class="skill-modal">
            <div class="skill-modal-header">
              <span id="modalTitle" style="flex: 1;"></span>
              <button class="skill-modal-close" aria-label="Close">✕</button>
            </div>
            <div class="skill-modal-body" id="modalBody"></div>
          </div>
        `;
        document.body.appendChild(modalOverlay);
      }

      const tooltipHeader = tooltip.querySelector('.skill-tooltip-header');
      const tooltipBody   = tooltip.querySelector('.skill-tooltip-body');
      const modalHeader   = modalOverlay.querySelector('.skill-modal-header');
      const modalTitle    = modalOverlay.querySelector('#modalTitle');
      const modalBody     = modalOverlay.querySelector('#modalBody');
      const closeBtn      = modalOverlay.querySelector('.skill-modal-close');

      // ---------- State ----------
      let activeEl = null;
      let tooltipTimeout = null;

      // ---------- Helpers ----------
      const findInteractive = (target) => {
        if (!(target instanceof Element)) return null;
        return target.closest('.skill-effect, .weapon-item, .set-item-triangle');
      };

      const getType = (el) => {
        if (!el) return 'buff';
        if (el.classList.contains('weapon-item')) return 'weapon';
        if (el.classList.contains('set-item-triangle')) return 'set';
        if (el.classList.contains('effect-debuff')) return 'debuff';
        if (el.classList.contains('effect-disable')) return 'disable';
        return 'buff';
      };

      const getData = (el) => {
        if (!el) return { name: 'Unknown', description: 'No description', type: 'buff' };

        const name = el.dataset.name || el.dataset.effect || 'Unknown';

        let description = el.dataset.description || '';
        const inner = el.querySelector('[data-tooltip-target="content"]');
        if (inner && inner.innerText && inner.innerText.trim()) {
          description = inner.innerText.trim();
        }

        return {
          name,
          description: description || 'No description',
          type: getType(el),
        };
      };

      // ---------- Tooltip positioning ----------
      const positionTooltip = (e) => {
        const ww = window.innerWidth;
        const rect = tooltip.getBoundingClientRect();
        const tw = 300;
        const th = rect.height || 160;

        let x = e.clientX - tw / 2;
        let y = e.clientY - th - 12;

        if (x < 10) x = 10;
        if (x + tw > ww - 10) x = ww - tw - 10;
        if (y < 10) y = e.clientY + 12;

        tooltip.style.left = x + 'px';
        tooltip.style.top  = y + 'px';
      };

      const showTooltip = (el, e) => {
        const data = getData(el);

        tooltipHeader.textContent = data.name;
        tooltipHeader.className = `skill-tooltip-header ${data.type}`;

        tooltipBody.textContent = data.description;
        tooltip.className = `skill-tooltip ${data.type}`;
        tooltip.style.display = 'block';

        activeEl = el;
        positionTooltip(e);
      };

      const hideTooltip = () => {
        tooltip.style.display = 'none';
        activeEl = null;
        if (tooltipTimeout) clearTimeout(tooltipTimeout);
      };

      // ---------- Modal ----------
      const showModal = (el) => {
        const data = getData(el);

        modalTitle.textContent = data.name;
        modalHeader.className = `skill-modal-header ${data.type}`;
        modalBody.textContent = data.description;

        modalOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      };

      const closeModal = () => {
        modalOverlay.classList.remove('active');
        document.body.style.overflow = '';
      };

      // ---------- Events ----------
      if (isTouch) {
        document.addEventListener('click', (e) => {
          const el = findInteractive(e.target);
          if (!el) return;

          e.preventDefault();
          showModal(el);
        });

        if (closeBtn) closeBtn.addEventListener('click', closeModal);

        modalOverlay.addEventListener('click', (e) => {
          if (e.target === modalOverlay) closeModal();
        });
      } else {
        document.addEventListener('mouseenter', (e) => {
          const el = findInteractive(e.target);
          if (!el) return;

          if (tooltipTimeout) clearTimeout(tooltipTimeout);
          tooltipTimeout = setTimeout(() => showTooltip(el, e), 80);
        }, true);

        document.addEventListener('mouseleave', (e) => {
          const el = findInteractive(e.target);
          if (!el) return;

          hideTooltip();
        }, true);

        document.addEventListener('mousemove', (e) => {
          if (activeEl) positionTooltip(e);
        }, true);
      }

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          hideTooltip();
          closeModal();
        }
      });
    });
  </script>
{% endblock %}




